<?xml version="1.0"?>
<package format="3">
  <name>home_task_manager</name>
  <version>0.1.0</version>
  <description>Simulation-only Pick task manager using the existing TaskExecutor.</description>
  <maintainer email="noreply@github.com">Home Assistant contributors</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>home_task_interfaces</exec_depend>
  <exec_depend>home_robot_tasks</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
