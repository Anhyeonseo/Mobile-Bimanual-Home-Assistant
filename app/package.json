{
  "name": "hometekhu-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "preview": "node server.mjs --built",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/core.test.mjs tests/transport.test.mjs",
    "build": "node scripts/build.mjs && node scripts/verify-build.mjs",
    "format": "npx --yes prettier@3.6.2 --write \"src/**/*.js\" \"src/**/*.css\" \"src/*.html\" \"tests/*.mjs\" \"scripts/*.mjs\" server.mjs package.json"
  }
}
